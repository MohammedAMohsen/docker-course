# انسخ هذا الملف باسم .env ثم عدّل القيم.

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=tasks_db
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=change-this-password

# اسم حاوية قاعدة البيانات، وهو القيمة التي أعطيناها للخيار --name.
# داخل الشبكة نفسها، اسم الحاوية يعمل كعنوان.
POSTGRES_HOST=task-db
POSTGRES_PORT=5432
