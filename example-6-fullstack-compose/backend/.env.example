# Django
DJANGO_SECRET_KEY=change-this-development-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
DJANGO_TIME_ZONE=Asia/Riyadh

# PostgreSQL: استبدل كلمة المرور التجريبية بقيمة تختارها بنفسك.
POSTGRES_DB=nawa_tasks
POSTGRES_USER=nawa_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=workboard
POSTGRES_PORT=5432

# أصول المتصفح المسموح لها في حالة الاتصال المباشر بالـAPI.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
