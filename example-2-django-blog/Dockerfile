FROM python:latest

WORKDIR /app

# الخطوة الأولى: نسخ ملف المكتبات وحده ثم تثبيتها.
COPY requirements.txt .

RUN pip install -r requirements.txt

# الخطوة الثانية: نسخ بقية كود المشروع.
COPY . .

# 0.0.0.0 تعني: استقبل الاتصالات من خارج الحاوية.
# لو كتبنا 127.0.0.1 فلن يصل المتصفح إلى الخادم أبداً.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]


# لماذا أمرَا نسخ وليس أمراً واحداً؟
#
# كل تعليمة في هذا الملف تصنع طبقة، ويحفظ Docker كل طبقة في ذاكرة مؤقتة.
# عند إعادة البناء، يعيد Docker استخدام الطبقة المحفوظة إذا لم تتغيّر ملفاتها.
# لكن عند أول طبقة تغيّرت، يعيد بناءها وبناء كل الطبقات التي بعدها.
#
# الكود يتغيّر كثيراً، أما ملف المكتبات فنادراً ما يتغيّر.
# لذلك نسخنا ملف المكتبات أولاً وثبّتناها، ثم نسخنا الكود.
# النتيجة: عند تعديل الكود فقط، يتخطى Docker تثبيت المكتبات ويأخذها من الذاكرة.
#
# لو كتبنا نسخ الكل أولاً ثم التثبيت، فأي تعديل صغير في الكود
# يعيد تحميل وتثبيت كل المكتبات من جديد في كل مرة.


# طريقة التشغيل:
#
# 1) انتقل إلى مجلد المشروع:
#    cd example-2-django-blog
#
# 2) ابنِ الصورة:
#    docker build -t django-app:latest .
#
# 3) شغّل الحاوية مع ملف المتغيّرات وربط المنفذ:
#    docker run --rm --env-file .env -p 8000:8000 django-app
#
# في نسخة نظيفة بلا قاعدة بيانات، شغّل الترحيلات قبل الخادم (انظر README).
