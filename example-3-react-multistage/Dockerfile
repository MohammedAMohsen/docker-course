# بناء متعدد المراحل
#
# المرحلة الأولى تحتاج Node لبناء الموقع، وصورتها كبيرة.
# المرحلة الثانية تحتاج فقط ملفات الموقع الجاهزة وخادم ويب صغير.
# الصورة النهائية تتكوّن من المرحلة الأخيرة فقط، فيبقى Node خارجها.


# ===== المرحلة الأولى: البناء =====

# الكلمة builder اسم نعطيه لهذه المرحلة حتى نشير إليها لاحقاً.
FROM node:latest AS builder

WORKDIR /app

# ملفات المكتبات أولاً، للاستفادة من ذاكرة البناء المؤقتة (كما في المثال الثاني).
COPY package*.json .

RUN npm install

COPY . .

# يُنتج ملفات الموقع النهائية داخل المجلد /app/dist
RUN npm run build


# ===== المرحلة الثانية: التشغيل =====

FROM nginx:alpine

# ننسخ من المرحلة الأولى مجلد dist فقط، إلى المجلد الذي يقدّم منه Nginx الملفات.
COPY --from=builder /app/dist /usr/share/nginx/html

# توثيق فقط: الخادم يستمع على المنفذ 80 داخل الحاوية.
# هذه التعليمة لا تفتح المنفذ على الجهاز، الذي يفتحه هو الخيار -p عند التشغيل.
EXPOSE 80

# تشغيل Nginx في المقدمة، حتى تبقى الحاوية تعمل ما دام الخادم يعمل.
CMD [ "nginx", "-g", "daemon off;" ]


# طريقة التشغيل:
#
# docker build -t react-app:latest .
# docker run -it --rm -p 3001:80 react-app:latest
#
# ثم افتح: http://localhost:3001
