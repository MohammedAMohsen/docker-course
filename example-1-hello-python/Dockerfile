# الصورة الأساسية: نظام صغير مثبّت عليه Python جاهز.
# ملاحظة: الوسم latest يتغيّر مع الوقت، والأفضل تثبيت رقم الإصدار (انظر README).
FROM python:latest

# المجلد الذي نعمل داخله في الحاوية. ينشئه Docker إذا لم يكن موجوداً.
WORKDIR /app

# نسخ كل ملفات المجلد الحالي (من الجهاز) إلى مجلد العمل /app (داخل الصورة).
COPY . .

# الأمر الذي يُنفَّذ عند تشغيل الحاوية.
CMD [ "python", "index.py" ]


# طريقة التشغيل:
#
# 1) انتقل إلى مجلد هذا الملف:
#    cd example-1-hello-python
#
# 2) ابنِ الصورة وأعطها اسماً:
#    docker build -t hello-python:latest .
#
# 3) شغّل الصورة، فينشئ Docker حاوية منها:
#    docker run --rm hello-python
