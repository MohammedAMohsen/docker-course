# انسخ هذا الملف باسم backend.env
# هذه المتغيّرات تدخل حاويتي migrate و backend فقط، عبر المفتاح env_file.

# مفتاح طويل عشوائي. يرفض المشروع التشغيل بالمفتاح الافتراضي عندما يكون DEBUG متوقفاً.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_TIME_ZONE=Asia/Riyadh
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
